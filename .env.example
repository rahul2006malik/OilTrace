# ==============================================================================
# OilTrace — Environment Variables Template (.env.example)
# ==============================================================================
# Copy this file to .env and replace the placeholder values with your real keys.
# NEVER commit your .env file to version control!

# Global Fishing Watch (GFW) API Token (v2 API)
# Register at: https://globalfishingwatch.org/our-apis/
GFW_API_TOKEN=your_gfw_api_token_here

# AISstream WebSocket API Key
# Register at: https://aisstream.io/
AISSTREAM_API_KEY=your_aisstream_api_key_here
